{
  "name": "ts-liba",
  "version": "1.0.0",
  "description": "Utils and types helpers",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "format": "dprint fmt",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "jest --verbose ./tests",
    "test-watch": "jest --watch --verbose ./tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DedaVnuk/ts-liba.git"
  },
  "keywords": [
    "Liba",
    "typescript",
    "ts",
    "utils",
    "helpers",
    "types"
  ],
  "author": "Sumarokov Vladimir <sumarokov.world@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DedaVnuk/ts-liba/issues"
  },
  "homepage": "https://github.com/DedaVnuk/ts-liba#readme",
  "devDependencies": {
    "@types/jest": "^29.5.4",
    "dprint": "^0.44.0",
    "jest": "^29.6.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "uglify-js": "^3.17.4"
  }
}
